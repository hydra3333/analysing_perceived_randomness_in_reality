<Configuration>
  <VGpu>Enable</VGpu>
  <Networking>Default</Networking>
  <PrinterRedirection>Enable</PrinterRedirection>
  <ClipboardRedirection>Default</ClipboardRedirection>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\software</HostFolder>
      <SandboxFolder>C:\HOST_SOFTWARE</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>T:\OUTLANDISH_01_SANDBOX</HostFolder>
      <SandboxFolder>C:\HOST_OUTLANDISH_SOURCE</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>T:\OUTLANDISH_01_SANDBOX_DATA</HostFolder>
      <SandboxFolder>C:\HOST_OUTLANDISH_DATA</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>C:\HOST_OUTLANDISH_SOURCE\SANDBOX\OUTLANDISH_01_Setup.bat</Command>
  </LogonCommand>
</Configuration>
