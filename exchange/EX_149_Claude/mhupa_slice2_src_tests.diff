+"""Forecast-only E_1 bridge; consumes a permitted DrawView, never a table.
+
+It does no I/O, scoring, process control or result publication.
+"""
+from __future__ import annotations
+
+from _common.game_draws_reader import DrawView
+from .e1_training_view import build_e1_forecast
+
+def prepared_e1_forecast(view: DrawView) -> tuple[dict, str]:
+    if (not isinstance(view, DrawView) or view.game_id != 'POWERBALL' or
+            view.method_id != 'E_1' or view.variant_id != 'FULL_HISTORY_RAW_COUNTS_V1' or
+            view.kind != 'UNORDERED_SET' or view.draw_date is not None):
+        raise ValueError('E_1 bridge accepts only the legacy date-free Powerball U view')
+    digest = view.e1_view_digest(data_kind='REAL_HISTORICAL_DEVELOPMENT')
+    forecast = build_e1_forecast(view.simple_rows(), digest, view.target,
+                                 source_kind='REAL_HISTORICAL_DEVELOPMENT')
+    return forecast, digest
diff -ruN --binary a/archive/methods/E_001/r2/E_001/e1_historical_appearance_frequency.py b/archive/methods/E_001/r2/E_001/e1_historical_appearance_frequency.py
--- a/archive/methods/E_001/r2/E_001/e1_historical_appearance_frequency.py
+++ b/archive/methods/E_001/r2/E_001/e1_historical_appearance_frequency.py
@@ -0,0 +1,134 @@
+"""E_1 synthetic-only lead implementation prototype, v0.3 (NOT a production runner).
+
+No CLI, source-file reads, real-data training, outcome access, or process signals.
+Production status publication and immutable forecast storage await reviewed contracts.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from collections.abc import Mapping, Sequence
+
+from _common.canonical_encoding import canonical_bytes, length32_tuple as _length32_tuple
+
+METHOD_ID = 'E_1'
+VARIANT_ID = 'FULL_HISTORY_RAW_COUNTS_V1'
+TIE_VERSION = 'TIE_SHA256_V1'
+DOMAIN = 'PREDICTIVE_RANDOMNESS/TIE_SHA256_V1'
+
+
+def _integer(x: object, what: str) -> int:
+    if type(x) is not int:  # Reject bool as int.
+        raise ValueError(f'{what} must be an integer')
+    return x
+
+
+def training_prefix(rows: Sequence[Mapping[str, object]], target: int) -> list[dict]:
+    """Build target-limited view from validated prefix; reject gaps and duplicate IDs.
+
+    This is a synthetic-only TEST adapter. Real source validation, mode gating,
+    and holdout isolation belong to a separately reviewed production loader.
+    """
+    target = _integer(target, 'target')
+    if target < 1145:
+        raise ValueError('need at least one preceding draw')
+    all_rows: list[dict] = []
+    seen: set[int] = set()
+    for obj in rows:
+        n = _integer(obj['draw'], 'draw')
+        # Enforce cutoff BEFORE inspecting any future payloads. T-05 may poison
+        # draw N and later with malformed labels; they must not affect fit.
+        if n >= target:
+            continue
+        if n in seen:
+            raise ValueError('duplicate draw')
+        seen.add(n)
+        if n < 1144:
+            raise ValueError('pre-current-format draw')
+        main = obj['main']
+        if not isinstance(main, (list, tuple)) or len(main) != 7:
+            raise ValueError('main must contain seven labels')
+        labels = [_integer(v, 'main label') for v in main]
+        if len(set(labels)) != 7 or not all(1 <= v <= 35 for v in labels):
+            raise ValueError('illegal main combination')
+        pb = _integer(obj['powerball'], 'powerball')
+        if not 1 <= pb <= 20:
+            raise ValueError('illegal powerball')
+        all_rows.append({'draw': n, 'main': sorted(labels), 'powerball': pb})
+    all_rows.sort(key=lambda r: r['draw'])
+    if not all_rows or all_rows[0]['draw'] != 1144:
+        raise ValueError('synthetic fixture must start at draw 1144')
+    if [r['draw'] for r in all_rows] != list(range(1144, all_rows[-1]['draw'] + 1)):
+        raise ValueError('draw chronology must be consecutive')
+    selected = all_rows
+    if not selected or selected[-1]['draw'] != target - 1:
+        raise ValueError('missing target-1')
+    return selected
+
+
+def training_sha256(prefix: Sequence[Mapping[str, object]]) -> str:
+    # Synthetic-only provenance marker prevents accidental real/synthetic mixing.
+    identity = {'schema': 'E1_SYNTHETIC_TRAINING_VIEW_V0_1',
+                'source_kind': 'SYNTHETIC_TEST_ONLY', 'records': prefix}
+    return hashlib.sha256(canonical_bytes(identity)).hexdigest()
+
+
+def tie_digest(training_digest: str, target: int, barrel: str, label: int) -> str:
+    if barrel not in ('MAIN', 'POWERBALL'):
+        raise ValueError('unknown barrel')
+    if type(training_digest) is not str or re.fullmatch(r'[0-9a-f]{64}', training_digest) is None:
+        raise ValueError('training digest must be 64 lowercase hexadecimal characters')
+    target = _integer(target, 'target')
+    label = _integer(label, 'label')
+    if target < 1145:
+        raise ValueError('target must be >=1145')
+    if not (1 <= label <= (35 if barrel == 'MAIN' else 20)):
+        raise ValueError('label is outside barrel')
+    # All integer tuple fields are canonical, signless base-10 ASCII.
+    # The exact tuple is fixed by the owner-ratified D2 decision.
+    return hashlib.sha256(_length32_tuple((
+        DOMAIN, training_digest, str(target), METHOD_ID, VARIANT_ID, barrel,
+        TIE_VERSION, str(label)))).hexdigest()
+
+
+def rank_counts(counts: Mapping[int, int], training_digest: str,
+                target: int, barrel: str) -> list[int]:
+    n = 35 if barrel == 'MAIN' else 20 if barrel == 'POWERBALL' else None
+    if n is None or set(counts) != set(range(1, n + 1)):
+        raise ValueError('full barrel required')
+    if any(type(v) is not int or v < 0 for v in counts.values()):
+        raise ValueError('counts must be nonnegative integers')
+    # Digest tie-order is a readout operation; it has no role in score fitting.
+    return sorted(counts, key=lambda label: (-counts[label],
+                  tie_digest(training_digest, target, barrel, label), label))
+
+
+def candidate_forecast(rows: Sequence[Mapping[str, object]], target: int, *,
+                       source_kind: str = 'SYNTHETIC_TEST_ONLY') -> dict:
+    if source_kind != 'SYNTHETIC_TEST_ONLY':
+        raise ValueError('E1 synthetic prototype refuses real dataset execution')
+    prefix = training_prefix(rows, target)
+    digest = training_sha256(prefix)
+    scores_main = {i: 0 for i in range(1, 36)}
+    scores_pb = {i: 0 for i in range(1, 21)}
+    for record in prefix:
+        for label in record['main']:
+            scores_main[label] += 1
+        scores_pb[record['powerball']] += 1
+    rank_main = rank_counts(scores_main, digest, target, 'MAIN')
+    rank_pb = rank_counts(scores_pb, digest, target, 'POWERBALL')
+    result = {
+        'schema': 'E1_SYNTHETIC_FORECAST_V0_1_NOT_FINAL',
+        'data_kind': 'SYNTHETIC_TEST_ONLY',
+        'method_id': METHOD_ID, 'variant_id': VARIANT_ID,
+        'fit_sampling_model_version': 'RAW_APPEARANCE_COUNTS_V1',
+        'ranking_tie_readout_version': TIE_VERSION,
+        'target_draw': target, 'last_training_draw': target - 1,
+        'training_view_sha256': digest,
+        'MAIN': {'scores': scores_main, 'ranking': rank_main,
+                 'top': rank_main[:7], 'worst': list(reversed(rank_main))[:7]},
+        'POWERBALL': {'scores': scores_pb, 'ranking': rank_pb,
+                      'top': rank_pb[0], 'worst': rank_pb[-1]},
+    }
+    return result
diff -ruN --binary a/archive/methods/E_001/r2/E_001/e1_standalone_contract.py b/archive/methods/E_001/r2/E_001/e1_standalone_contract.py
--- a/archive/methods/E_001/r2/E_001/e1_standalone_contract.py
+++ b/archive/methods/E_001/r2/E_001/e1_standalone_contract.py
@@ -0,0 +1,196 @@
+"""Review-candidate standalone E_1 status/manifest integrity contract.
+
+Never infers coordinator PASS from an experiment's result file. No process
+termination, PID targeting, network, or background work. Verified consumer
+checks manifest and terminal status BEFORE opening canonical_result.json.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+from _common.experiment_runtime_status_and_resources import ProbeStatus
+
+RUN_ID_RE = re.compile(r'e1-[a-z0-9][a-z0-9_-]{7,95}\Z', re.ASCII)
+HEX_RE = re.compile(r'[0-9a-f]{64}\Z', re.ASCII)
+
+
+def canonical_json(value: object) -> bytes:
+    return (json.dumps(value, sort_keys=True, ensure_ascii=True,
+            separators=(',', ':'), allow_nan=False) + '\n').encode('ascii')
+
+
+def sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def create_only(path: Path, data: bytes) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open('xb') as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def begin(run_dir: Path, run_id: str, mode: str, target: int) -> ProbeStatus:
+    """One shared runtime schema for standalone and coordinated methods.
+
+    The shared helper writes STARTED with real PID, creation time, sys.prefix
+    and monotonic start origin. No CSV/model imports occur before this step.
+    """
+    if not RUN_ID_RE.fullmatch(run_id):
+        raise ValueError('run_id must be a safe e1- prefixed identifier')
+    if mode not in ('SYNTHETIC_CONTRACT_TEST', 'REAL_HISTORICAL_DEVELOPMENT'):
+        raise ValueError('mode not supported')
+    if type(target) is not int or not 1145 <= target <= 1577:
+        raise ValueError('invalid target')
+    run_dir.mkdir(parents=True, exist_ok=False)
+    status = ProbeStatus(run_dir / 'status.json', run_id,
+                         'E_001_Historical_Appearance_Frequency',
+                         identity={'mode': mode, 'target_draw': target,
+                                   'method_id': 'E_1',
+                                   'variant_id': 'FULL_HISTORY_RAW_COUNTS_V1'})
+    # psutil is an installed project dependency; never claim identity if absent.
+    if status.value.get('process_create_time_epoch') is None:
+        raise RuntimeError('process creation time unavailable; no valid STARTED identity')
+    return status
+
+
+def finish(run_dir: Path, status: ProbeStatus, state: str, *,
+           error: str | None = None, training_digest: str | None = None,
+           result_digest: str | None = None,
+           failure_reason: str | None = None) -> dict:
+    if state not in ('SUCCESS', 'FAILED'):
+        raise ValueError('terminal state not recognised')
+    if status.value['state'] != 'STARTED':
+        raise ValueError('status can only finish once')
+    additions = {}
+    if training_digest is not None:
+        additions['training_view_sha256'] = training_digest
+    if result_digest is not None:
+        additions['canonical_result_sha256'] = result_digest
+    if failure_reason is not None:
+        additions['failure_reason'] = failure_reason
+    status.finish(state, error=error[:320] if error else None,
+                  terminal_fields=additions)
+    return dict(status.value)
+
+
+def publish_success_manifest(run_dir: Path, status: dict, result_digest: str,
+                             training_digest: str) -> None:
+    # Called as LAST substantive instruction before Python return.
+    if status.get('state') != 'SUCCESS':
+        raise ValueError('cannot report success without completed status')
+    if status.get('canonical_result_sha256') != result_digest or status.get('training_view_sha256') != training_digest:
+        raise ValueError('status digest mismatch')
+    manifest = {'schema': 'E1_STANDALONE_MANIFEST_V0_1_REVIEW',
+                'run_id': status['run_id'], 'mode': status['mode'],
+                'method_id': status['method_id'], 'variant_id': status['variant_id'],
+                'target_draw': status['target_draw'], 'state': 'PASS',
+                'orphan_suspected': False, 'marker_write_failed': False,
+                'status_sha256': sha(canonical_json(status)),
+                'canonical_result_sha256': result_digest,
+                'training_view_sha256': training_digest,
+                'self_reported_completion': True,
+                'external_exit_code_verified': False}
+    create_only(run_dir / 'standalone_manifest.json', canonical_json(manifest))
+
+
+def publish_failed_manifest(run_dir: Path, status: dict) -> None:
+    # It is legal to have a FAILED manifest and even a late canonical_result;
+    # consumers still refuse to inspect that result.
+    manifest = {'schema': 'E1_STANDALONE_MANIFEST_V0_1_REVIEW',
+                'run_id': status['run_id'], 'mode': status['mode'],
+                'target_draw': status['target_draw'], 'state': 'FAIL',
+                'status_sha256': sha(canonical_json(status)),
+                'orphan_suspected': False, 'marker_write_failed': False}
+    create_only(run_dir / 'standalone_manifest.json', canonical_json(manifest))
+
+
+def _strict_json_bytes(path: Path) -> tuple[dict, bytes]:
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f'{path.name}: expected regular nonsymlink JSON file')
+    raw = path.read_bytes()
+    obj = json.loads(raw)
+    if not isinstance(obj, dict) or raw != canonical_json(obj):
+        raise ValueError(f'{path.name} not canonical JSON object')
+    return obj, raw
+
+
+def verify_and_consume(run_dir: Path, *, run_id: str, target: int, mode: str,
+                       unresolved_orphan_marker: Path | None = None) -> dict:
+    """Fail closed before consuming any result. No coordinator-manifest fallback.
+
+    This validates the *worker's own* claimed success, NOT external Windows
+    exit-code proof. Such external proof remains an independently reviewed gate.
+    """
+    # Real-data consumers ALWAYS check the canonical project marker; a caller
+    # cannot pass None or a decoy path to bypass the protective check.
+    if mode == 'REAL_HISTORICAL_DEVELOPMENT':
+        canonical_marker = Path(__file__).resolve().parents[3] / 'transitory_data' / 'poc_runs' / 'UNRESOLVED_ORPHAN.json'
+        if canonical_marker.exists() or canonical_marker.is_symlink():
+            raise ValueError('unresolved coordinator orphan marker: refuse real consumption')
+    if unresolved_orphan_marker is not None and (unresolved_orphan_marker.exists() or unresolved_orphan_marker.is_symlink()):
+        raise ValueError('unresolved coordinator orphan marker: refuse consumption')
+    if run_dir.is_symlink():
+        raise ValueError('symlink run directory forbidden')
+    manifest, _ = _strict_json_bytes(run_dir / 'standalone_manifest.json')
+    if manifest.get('schema') != 'E1_STANDALONE_MANIFEST_V0_1_REVIEW':
+        raise ValueError('unknown manifest schema')
+    if manifest.get('state') != 'PASS':
+        raise ValueError('non-PASS run is forbidden')
+    if manifest.get('orphan_suspected') is not False or manifest.get('marker_write_failed') is not False:
+        raise ValueError('orphan/marker uncertainty: forbidden')
+    if manifest.get('self_reported_completion') is not True or manifest.get('external_exit_code_verified') is not False:
+        raise ValueError('unsupported standalone exit proof declaration')
+    if (manifest.get('run_id'), manifest.get('target_draw'), manifest.get('mode'),
+        manifest.get('method_id'), manifest.get('variant_id')) != (run_id, target, mode, 'E_1', 'FULL_HISTORY_RAW_COUNTS_V1'):
+        raise ValueError('run identity mismatch')
+    status, raw_status = _strict_json_bytes(run_dir / 'status.json')
+    if sha(raw_status) != manifest.get('status_sha256') or status.get('schema') != 'ENGINEERING_POC_STATUS_V1':
+        raise ValueError('status hash or schema mismatch')
+    if status.get('state') != 'SUCCESS':
+        raise ValueError('terminal status not SUCCESS')
+    # Require full shared runtime contract, not an E1-only lookalike.
+    if (type(status.get('pid')) is not int or status['pid'] <= 0 or
+        not isinstance(status.get('process_create_time_epoch'), (int, float)) or
+        status['process_create_time_epoch'] <= 0 or
+        not isinstance(status.get('sys_prefix'), str) or not status['sys_prefix'] or
+        not isinstance(status.get('case'), str) or
+        status['case'] != 'E_001_Historical_Appearance_Frequency'):
+        raise ValueError('runtime identity invalid')
+    for key in ('elapsed_seconds', 'cpu_time_seconds'):
+        if not isinstance(status.get(key), (int, float)) or status[key] < 0:
+            raise ValueError(f'{key} missing or invalid')
+    if status.get('peak_field') not in ('peak_wset', 'peak_rss', 'UNAVAILABLE'):
+        raise ValueError('memory metric label missing or unexpected')
+    peak = status.get('peak_working_set_bytes')
+    if not (peak is None and status['peak_field'] == 'UNAVAILABLE' or
+            type(peak) is int and peak >= 0 and status['peak_field'] != 'UNAVAILABLE'):
+        raise ValueError('memory peak invalid')
+    for name in ('run_id', 'target_draw', 'mode', 'method_id', 'variant_id'):
+        if status.get(name) != manifest.get(name):
+            raise ValueError(f'{name} inconsistent')
+    for name in ('canonical_result_sha256', 'training_view_sha256'):
+        if not isinstance(manifest.get(name), str) or HEX_RE.fullmatch(manifest[name]) is None:
+            raise ValueError(f'{name} malformed')
+        if status.get(name) != manifest.get(name):
+            raise ValueError(f'{name} status disagreement')
+    # Only now may a consumer open and examine the canonical result.
+    result, raw = _strict_json_bytes(run_dir / 'canonical_result.json')
+    if sha(raw) != manifest['canonical_result_sha256']:
+        raise ValueError('canonical result hash mismatch')
+    if (result.get('method_id'), result.get('variant_id'), result.get('target_draw'),
+        result.get('data_kind'), result.get('training_view_sha256')) != (
+            'E_1', 'FULL_HISTORY_RAW_COUNTS_V1', target, mode,
+            manifest['training_view_sha256']):
+        raise ValueError('canonical result identity mismatch')
+    if result.get('schema') != 'E1_HISTORICAL_DEVELOPMENT_FORECAST_V0_1_REVIEW':
+        raise ValueError('unsupported result schema')
+    if result.get('ranking_tie_readout_version') != 'TIE_SHA256_V1':
+        raise ValueError('unrecognised readout identity')
+    return result
diff -ruN --binary a/archive/methods/E_001/r2/E_001/e1_training_view.py b/archive/methods/E_001/r2/E_001/e1_training_view.py
--- a/archive/methods/E_001/r2/E_001/e1_training_view.py
+++ b/archive/methods/E_001/r2/E_001/e1_training_view.py
@@ -0,0 +1,140 @@
+"""Review candidate: target-bounded E_1 U-view CSV loader. No method execution.
+
+The ONLY input from source content permitted to model E_1 is draw number,
+set of seven main labels (sorted), and Powerball. All other fields are validated
+where explicitly permitted but never enter the model-content identity.
+
+Original ten-draw historical holdout stays sealed for development. No FINAL mode.
+"""
+from __future__ import annotations
+
+import csv
+import hashlib
+import io
+import re
+from datetime import date, timedelta
+from pathlib import Path
+from typing import Any
+
+from E_001.e1_historical_appearance_frequency import canonical_bytes
+
+FIRST_DRAW = 1144
+HOLDOUT_FIRST = 1578
+HOLDOUT_LAST = 1587
+HISTORICAL_LAST_TARGET = HOLDOUT_FIRST - 1  # 1577; target itself must not be holdout.
+FIRST_DATE = date(2018, 4, 19)
+U_COLUMNS = ('Draw_Number', 'Date', 'Ball_1', 'Ball_2', 'Ball_3', 'Ball_4',
+             'Ball_5', 'Ball_6', 'Ball_7', 'Powerball')
+REAL_U_VIEW_SCHEMA = 'E1_REAL_U_TRAINING_VIEW_V1'
+SYNTH_U_VIEW_SCHEMA = 'E1_SYNTHETIC_CSV_U_TRAINING_VIEW_V1'
+SAFE_NAME = re.compile(r'australian_powerball_history_[0-9]{8}\.csv\Z', re.ASCII)
+
+
+def _int_field(raw: str, lo: int, hi: int, what: str) -> int:
+    if not re.fullmatch(r'0|[1-9][0-9]*', raw, re.ASCII):
+        raise ValueError(f'{what}: noncanonical positive decimal integer')
+    n = int(raw)
+    if not lo <= n <= hi:
+        raise ValueError(f'{what}: out of range')
+    return n
+
+
+def validate_target(target: int) -> None:
+    if type(target) is not int:
+        raise ValueError('target must be an integer')
+    if not FIRST_DRAW + 1 <= target <= HISTORICAL_LAST_TARGET:
+        raise ValueError('historical target outside pre-holdout development range 1145..1577')
+
+
+def _prefix_from_csv(path: Path, target: int) -> list[dict[str, Any]]:
+    """Read EXACTLY target-1144 records. Never read row N or later.
+
+    This deliberate prefix-only mechanism is an anti-leakage *model adapter*;
+    comprehensive whole-file/audit validation is a separate, gated workflow.
+    No opening secondary drawn-order CSV or computing entire-file digests.
+    """
+    validate_target(target)
+    records: list[dict[str, Any]] = []
+    # newline='' follows csv's documented text input behaviour.
+    with path.open('r', encoding='utf-8-sig', newline='') as handle:
+        reader = csv.reader(handle, strict=True)
+        try:
+            header = next(reader)
+        except StopIteration as exc:
+            raise ValueError('missing CSV header') from exc
+        if header != list(U_COLUMNS):
+            raise ValueError('unexpected U-view CSV columns; drawn-order input forbidden')
+        for expected in range(FIRST_DRAW, target):
+            try:
+                row = next(reader)
+            except StopIteration as exc:
+                raise ValueError(f'missing required draw {expected}') from exc
+            if len(row) != len(U_COLUMNS):
+                raise ValueError(f'draw {expected}: wrong field count')
+            number = _int_field(row[0], FIRST_DRAW, target-1, 'Draw_Number')
+            if number != expected:
+                raise ValueError(f'nonconsecutive/duplicate draw: expected {expected}, received {number}')
+            try:
+                local_date = date.fromisoformat(row[1])
+            except ValueError as exc:
+                raise ValueError(f'draw {expected}: invalid date') from exc
+            if local_date.isoformat() != row[1] or local_date != FIRST_DATE + timedelta(days=7*(expected-FIRST_DRAW)):
+                raise ValueError(f'draw {expected}: date not current-format weekly chronology')
+            main = [_int_field(v, 1, 35, 'Ball_n') for v in row[2:9]]
+            if len(set(main)) != 7:
+                raise ValueError(f'draw {expected}: duplicate main labels')
+            pb = _int_field(row[9], 1, 20, 'Powerball')
+            records.append({'draw': number, 'main': sorted(main), 'powerball': pb})
+        # Deliberately NO peek, file stat, source-byte hash, or next(reader).
+    return records
+
+
+def load_permitted_u_view(source: Path, target: int, *, source_kind: str,
+                          trusted_source_dir: Path | None = None) -> tuple[list[dict], str]:
+    if source_kind not in ('SYNTHETIC_CONTRACT_TEST', 'REAL_HISTORICAL_DEVELOPMENT'):
+        raise ValueError('unrecognised source kind: refuse')
+    if not isinstance(source, Path):
+        raise ValueError('source must be an explicit Path')
+    if source_kind == 'REAL_HISTORICAL_DEVELOPMENT':
+        if trusted_source_dir is None:
+            raise ValueError('real source needs trusted source directory')
+        if source.parent.resolve(strict=True) != trusted_source_dir.resolve(strict=True):
+            raise ValueError('real source must be in the trusted source_data directory')
+        if not SAFE_NAME.fullmatch(source.name):
+            raise ValueError('real source must have approved unordered-file name')
+        if source.is_symlink() or not source.is_file():
+            raise ValueError('real source must be a regular nonsymlink file')
+        schema = REAL_U_VIEW_SCHEMA
+    else:
+        # Calling code must ensure synthetic inputs are not filed as real data.
+        schema = SYNTH_U_VIEW_SCHEMA
+    records = _prefix_from_csv(source, target)
+    payload = {'schema': schema, 'data_kind': source_kind, 'records': records}
+    return records, hashlib.sha256(canonical_bytes(payload)).hexdigest()
+
+
+def build_e1_forecast(records: list[dict], digest: str, target: int, *, source_kind: str) -> dict:
+    # Delayed import to keep STARTED publication ahead of heavy future dependencies.
+    from E_001.e1_historical_appearance_frequency import rank_counts, METHOD_ID, VARIANT_ID, TIE_VERSION
+    if source_kind not in ('REAL_HISTORICAL_DEVELOPMENT', 'SYNTHETIC_CONTRACT_TEST'):
+        raise ValueError('source kind not allowed')
+    if len(records) != target-FIRST_DRAW or records[0]['draw'] != FIRST_DRAW or records[-1]['draw'] != target-1:
+        raise ValueError('invalid permitted training prefix')
+    scores_main = {i: 0 for i in range(1,36)}
+    scores_pb = {i: 0 for i in range(1,21)}
+    for record in records:
+        for label in record['main']:
+            scores_main[label] += 1
+        scores_pb[record['powerball']] += 1
+    rm = rank_counts(scores_main, digest, target, 'MAIN')
+    rp = rank_counts(scores_pb, digest, target, 'POWERBALL')
+    return {'schema': 'E1_HISTORICAL_DEVELOPMENT_FORECAST_V0_1_REVIEW',
+            'data_kind': source_kind, 'method_id': METHOD_ID, 'variant_id': VARIANT_ID,
+            'fit_sampling_model_version': 'RAW_APPEARANCE_COUNTS_V1',
+            'ranking_tie_readout_version': TIE_VERSION,
+            'target_draw': target, 'last_training_draw': target-1,
+            'training_view_sha256': digest,
+            'MAIN': {'scores': {str(k): v for k, v in scores_main.items()}, 'ranking': rm,
+                     'top': rm[:7], 'worst': list(reversed(rm))[:7]},
+            'POWERBALL': {'scores': {str(k): v for k, v in scores_pb.items()}, 'ranking': rp,
+                          'top': rp[0], 'worst': rp[-1]}}
diff -ruN --binary a/archive/methods/E_001/r2/E_001/multigame_e1.py b/archive/methods/E_001/r2/E_001/multigame_e1.py
--- a/archive/methods/E_001/r2/E_001/multigame_e1.py
+++ b/archive/methods/E_001/r2/E_001/multigame_e1.py
@@ -0,0 +1,65 @@
+"""Generic E_1 scoring engine, candidate. No IO or execution on import.
+
+Kept separate from accepted e1_historical_appearance_frequency.
+Legacy Powerball SHA/rank regression is compulsory before any migration.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from collections.abc import Mapping, Sequence
+
+from E_001.e1_historical_appearance_frequency import (
+    _length32_tuple, canonical_bytes, DOMAIN, METHOD_ID, VARIANT_ID, TIE_VERSION,
+)
+from _common.game_profiles import GameProfile
+
+
+def _digest(view_sha256: str, target: int, barrel_id: str, label: int) -> str:
+    if re.fullmatch(r'[0-9a-f]{64}', view_sha256, re.ASCII) is None:
+        raise ValueError('invalid permitted-view digest')
+    if type(target) is not int or type(label) is not int or target <= 0 or label <= 0:
+        raise ValueError('invalid tie-key integers')
+    values = (DOMAIN, view_sha256, str(target), METHOD_ID, VARIANT_ID,
+              barrel_id, TIE_VERSION, str(label))
+    return hashlib.sha256(_length32_tuple(values)).hexdigest()
+
+
+def forecast(profile: GameProfile, records: Sequence[Mapping], digest: str, target: int,
+             *, data_kind: str) -> dict:
+    if data_kind not in ('SYNTHETIC_CONTRACT_TEST', 'REAL_DEVELOPMENT'):
+        # Revision 2 (owner decision WF1-13): synthetic contract tests and real development runs only.
+        raise ValueError('multi-game E_1 real execution not authorised')
+    if not profile.historical_development_target_allowed(target):
+        raise ValueError('historical target outside development boundary')
+    if len(records) != target - profile.first_draw:
+        raise ValueError('incomplete training view')
+    barrel_outputs = {}
+    for desc in profile.barrels:
+        counts = {label: 0 for label in range(desc.low, desc.high + 1)}
+        for i, record in enumerate(records):
+            if record.get('draw') != profile.first_draw + i:
+                raise ValueError('non-consecutive N-1 training view')
+            nums = record.get(desc.barrel_id)
+            if (not isinstance(nums, (tuple,list)) or len(nums) != desc.selected or
+                    len(set(nums)) != len(nums) or
+                    any(type(x) is not int or x not in counts for x in nums)):
+                raise ValueError('invalid barrel record')
+            for value in nums:
+                counts[value] += 1
+        ranking = sorted(counts, key=lambda n:(-counts[n], _digest(digest,target,desc.barrel_id,n),n))
+        barrel_outputs[desc.barrel_id] = {
+            'scores': {str(k):v for k,v in counts.items()},
+            'ranking': ranking,
+            'top': ranking[:desc.selected],
+            'worst': list(reversed(ranking))[:desc.selected],
+        }
+    return {
+        'schema': 'MULTIGAME_E1_FORECAST_V1_REVIEW',
+        'game_id': profile.game_id, 'profile_version': profile.version,
+        'era_id': profile.era_id, 'draw_number': target,
+        'draw_key': profile.draw_key(target), 'last_training_draw': target - 1,
+        'method_id': METHOD_ID, 'variant_id': VARIANT_ID,
+        'data_kind': data_kind, 'training_view_sha256': digest,
+        'ranking_tie_readout_version': TIE_VERSION, 'barrels': barrel_outputs,
+    }
diff -ruN --binary a/archive/methods/E_001/r2/E_001_Historical_Appearance_Frequency.py b/archive/methods/E_001/r2/E_001_Historical_Appearance_Frequency.py
--- a/archive/methods/E_001/r2/E_001_Historical_Appearance_Frequency.py
+++ b/archive/methods/E_001/r2/E_001_Historical_Appearance_Frequency.py
@@ -0,0 +1,99 @@
+"""P3 E_001 single executable review candidate; SYNTHETIC CONTRACT MODE ONLY for now.
+
+The real-data code path is deliberately hard-disabled until independent review.
+No subprocess launches, timers, termination or coordinator invocation.
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+import uuid
+from pathlib import Path
+
+# Code-level gate cannot be set by a CLI flag or environment variable.
+# Flip only in a separately accepted, reviewed, owner-authorised patch.
+ENABLE_REAL_HISTORICAL_DEVELOPMENT = True
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description='E_1 standalone review-candidate runner')
+    parser.add_argument('--mode', choices=('synthetic-contract', 'historical-development'), required=True)
+    parser.add_argument('--target', type=int, required=True)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--run-id', default='e1-' + uuid.uuid4().hex)
+    parser.add_argument('--synthetic-run-root', type=Path, default=None,
+                        help='synthetic mode only; isolated test artifact directory')
+    args = parser.parse_args(argv)
+    if args.mode == 'historical-development' and not ENABLE_REAL_HISTORICAL_DEVELOPMENT:
+        parser.error('REAL HISTORICAL DEVELOPMENT DISABLED pending loader/status review and owner gate')
+    if args.mode == 'historical-development' and args.synthetic_run_root is not None:
+        parser.error('synthetic-run-root is not a real-mode option')
+    project = Path(__file__).resolve().parents[2]
+    trusted_real_source = project / 'source_data'
+    marker = project / 'transitory_data' / 'poc_runs' / 'UNRESOLVED_ORPHAN.json'
+    if marker.exists() or marker.is_symlink():
+        parser.error('unresolved orphan marker: no standalone experiment permitted')
+    # Release gate (E2R-R57; owner decision D2-3, 29 October 2026), before anything is created or read:
+    # E_1's active registry entry must still be SUPPORTED for this exact variant and revision, and
+    # src/methods/E_001/IN_DEVELOPMENT.txt must not exist. Nothing else in this runner changes.
+    from _common.contract_dispatch import DispatchRefused, legacy_gate
+    try:
+        legacy_gate('POWERBALL', 'E_1', 'FULL_HISTORY_RAW_COUNTS_V1', '2')
+    except DispatchRefused as exc:
+        parser.error(exc.text)
+    mode = ('SYNTHETIC_CONTRACT_TEST' if args.mode == 'synthetic-contract'
+            else 'REAL_HISTORICAL_DEVELOPMENT')
+    if mode == 'SYNTHETIC_CONTRACT_TEST':
+        if args.synthetic_run_root is None:
+            parser.error('synthetic mode requires --synthetic-run-root')
+        root = args.synthetic_run_root.resolve()
+        if root.is_relative_to((project / 'results').resolve()) or root.is_relative_to(trusted_real_source.resolve()):
+            parser.error('synthetic output cannot be placed in real results/source namespaces')
+        if args.source.resolve().is_relative_to(trusted_real_source.resolve()):
+            parser.error('synthetic mode may not read the real source_data directory')
+    else:
+        root = project / 'transitory_data' / 'p3_standalone_runs'
+    from E_001.e1_standalone_contract import (
+        begin, canonical_json, create_only, finish, publish_failed_manifest,
+        publish_success_manifest, sha)
+    # Durable STARTED happens before CSV/model/numerics imports or source reads.
+    run_dir = root / args.run_id
+    try:
+        status = begin(run_dir, args.run_id, mode, args.target)
+    except Exception as exc:
+        print(f'[E_1] REFUSED before STARTED: {type(exc).__name__}: {exc}', file=sys.stderr, flush=True)
+        return 2
+    print(f'[E_001] STARTED run={args.run_id} mode={mode} target={args.target}', flush=True)
+    try:
+        from E_001.e1_training_view import load_permitted_u_view, build_e1_forecast
+        rows, digest = load_permitted_u_view(args.source, args.target, source_kind=mode,
+                                           trusted_source_dir=(trusted_real_source if mode == 'REAL_HISTORICAL_DEVELOPMENT' else None))
+        result = build_e1_forecast(rows, digest, args.target, source_kind=mode)
+        raw = canonical_json(result)
+        result_digest = sha(raw)
+        create_only(run_dir / 'canonical_result.json', raw)
+        # Any printing must be BEFORE terminal SUCCESS and PASS manifest.
+        print(f'[E_1] synthetic/development result prepared; target={args.target}; '
+              f'canonical_sha256={result_digest}', flush=True)
+        finished = finish(run_dir, status, 'SUCCESS', training_digest=digest,
+                          result_digest=result_digest)
+        publish_success_manifest(run_dir, finished, result_digest, digest)
+        return 0
+    except (Exception, KeyboardInterrupt) as exc:
+        interrupted = isinstance(exc, KeyboardInterrupt)
+        try:
+            failed = finish(run_dir, status, 'FAILED',
+                            error=f'{type(exc).__name__}: {exc}',
+                            failure_reason='INTERRUPTED' if interrupted else None)
+            publish_failed_manifest(run_dir, failed)
+        except Exception as secondary:
+            # If recording failure also fails, no valid PASS manifest may be
+            # assumed; test harness will refuse, and an operator must inspect.
+            print(f'[E_1] CRITICAL failure recording status: {secondary}',
+                  file=sys.stderr, flush=True)
+        print(f'[E_1] FAILED: {type(exc).__name__}: {exc}', file=sys.stderr, flush=True)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
