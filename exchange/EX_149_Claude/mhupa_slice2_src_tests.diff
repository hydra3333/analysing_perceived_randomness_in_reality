+    def hand_bound_run(self, plan, mem, target):
+        """A request bound to the plan, issued by hand (no ticket): the dispatch gate decides."""
+        req = WF.request_for(plan, mem, target, CP.new_run_id())
+        before = len(self.run_folders())
