+            adv = root / "results" / "real" / "holdout" / "POWERBALL" / "STUDY_VERSION_ADVANCE_POWERBALL_V1.json"
+            adv.write_text(json.dumps({"schema": ADVANCE_SCHEMA, "game_id": "POWERBALL", "admitted_version_after": 3,
