+
+
+def mode_h_batch_folder(root: Path, game_id: str, batch_id: str) -> Path:
+    return Path(root) / 'results' / 'real' / 'holdout' / 'wf_batches' / game_id / batch_id
+
+
+def mode_h_runs_root(root: Path) -> Path:
