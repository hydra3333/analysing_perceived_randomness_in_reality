+
+
+def study_manifest_path(root: Path, game_id: str) -> Path:
+    return holdout_root(root, game_id) / f'{STUDY_MANIFEST_SCHEMA}.json'
+
+
+def batch_id_record_path(root: Path, game_id: str) -> Path:
