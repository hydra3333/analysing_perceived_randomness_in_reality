+ALLOWED_PATH_LITERALS = {'results', 'real', 'holdout', 'wf_batches', 'weekly', 'source_data', 'MODE_H_BATCH_ID.json',
+                         'MODE_H_SEALED.json', 'ACTIVE_SESSION.lock', 'STUDY_VERSION_ADVANCE_{}_V1.json',
