+def prime_exponents_by_sieve(a):
+    """verify()'s independent exact-zero test: the same prime exponents, from a smallest-prime-factor sieve
+    (no trial division). The log combination is 0 exactly when this returns an empty map."""
+    top = max(a) if a else 1
+    spf = list(range(top + 1))
+    for i in range(2, int(top ** 0.5) + 1):
+        if spf[i] == i:
+            for m in range(i * i, top + 1, i):
+                if spf[m] == m:
+                    spf[m] = i
+    e = {}
+    for k, c in a.items():
+        while k > 1:
+            p = spf[k]
+            e[p] = e.get(p, 0) + c
+            k //= p
+    return {p: x for p, x in e.items() if x}
+
+
+def direct_sign(a):
+    """verify()'s second route. Exact zero by the sieve route; otherwise interval bounds on each ln k taken
+    directly, without factorising, which must exclude 0 because the value is then not 0."""
+    if not prime_exponents_by_sieve(a):
+        return 0
+    return certified_sign({k: c for k, c in a.items() if c})
 
 
