+def ln_bounds(k, terms):
+    """Rational bounds on ln k for an integer k >= 1: ln k = a ln 2 + ln(k / 2^a) with k / 2^a in [1, 2), and
+    ln m = 2 atanh((m - 1)/(m + 1)); ln 2 = 2 atanh(1/3)."""
+    a = k.bit_length() - 1
+    l2lo, l2hi = atanh_bounds(Fr(1, 3), terms)
+    m = Fr(k, 2 ** a)
+    lo, hi = (Fr(0), Fr(0)) if m == 1 else atanh_bounds((m - 1) / (m + 1), terms)
+    return 2 * a * l2lo + 2 * lo, 2 * a * l2hi + 2 * hi
+
