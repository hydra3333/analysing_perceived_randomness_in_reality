+                     [dict(self.good['sources'][0], url='https://beacon.nist.gov/beacon/2.0/pulse/last'),
+                      self.good['sources'][1]],
+                     [self.good['sources'][1], self.good['sources'][0]],
+                     [self.good['sources'][0], dict(self.good['sources'][1], read_by=self.good['sources'][0]['read_by'])],
